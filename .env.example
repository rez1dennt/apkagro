# Local preview runs with intake disabled and no administrator.
NODE_ENV=development
APP_HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
APP_INTAKE_ENABLED=false
# APP_DATA_KEY=<base64 encoding of 32 random bytes, stored privately>
# APP_DATA_DIR=<absolute private data directory>
# Production requires a loopback TLS reverse proxy, an absolute clamscan executable,
# approved legal documents/operator details, configured key and administrator.
# NODE_ENV=production
# APP_ORIGIN=https://your-approved-host.example
# APP_TRUSTED_PROXY=127.0.0.1
# Proxy must overwrite X-Real-IP with one actual client IP; strip client-supplied
# X-Real-IP / X-Forwarded-For and set X-Forwarded-Proto=https. Missing/invalid
# X-Real-IP fails closed in production. Only the configured loopback peer is trusted.
# APP_SCANNER_COMMAND=<absolute path to clamscan executable>
# APP_LEGALS_READY=false
