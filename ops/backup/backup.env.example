# Install as /etc/apkagro/backup.env, root:root 0600. This is trusted shell syntax.
# The default repository is encrypted, but remains on the same server as the app.
RESTIC_REPOSITORY=/var/backups/apkagro/restic
RESTIC_PASSWORD_FILE=/etc/apkagro/restic-password
BACKUP_HOST=apkagro-production
# Snapshot aborts after this time; the EXIT trap restores prior service state.
BACKUP_SECONDS=180
MAINTENANCE_SECONDS=600
RESTORE_SECONDS=1800
MIN_FREE_BYTES=1073741824
# For an approved offsite destination, change RESTIC_REPOSITORY and add the
# backend's required environment variables here. Keep credentials only here
# (0600) or in separate protected files; never in unit files or Git.
