[Unit]
Description=Encrypted consistent APKAgro application backup
After=local-fs.target network-online.target
Wants=network-online.target
OnFailure=apkagro-backup-alert.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=apkagro-backup
RuntimeDirectoryMode=0700
# Preserve restart intent until ExecStopPost/recovery resolves it.
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/sbin/apkagro-backup
# Also runs after a timeout/forced termination, when a shell EXIT trap cannot run.
ExecStopPost=/usr/local/sbin/apkagro-backup recover
TimeoutStartSec=45min
TimeoutStopSec=65s
KillMode=mixed
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/apkagro /var/cache/apkagro-restic /run/apkagro-backup /run/lock
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apkagro-backup
